# Copy to .env and edit. docker-compose.prod.yml passes everything here
# straight into the container.
#
#   cp .env.example .env

##############################################################################
# Image
##############################################################################
# Which published tag to run: latest, a release like v0.2.0, or sha-abc1234.
IMAGE_TAG=latest

##############################################################################
# Name
##############################################################################
# The one name to set. Sendspin, Bluetooth, Spotify, DLNA and the Home
# Assistant device all fall back to it, so the speaker shows up the same
# everywhere. It defaults to the machine's hostname if left unset.
#
# Each service can still be named separately -- the overrides are commented out
# in the sections below -- but there is rarely a reason to.
AIRPLAY_NAME=Living Room

# Name in Music Assistant. Defaults to AIRPLAY_NAME.
#SENDSPIN_NAME=Living Room

##############################################################################
# Audio output
##############################################################################
# The real ALSA device. Find yours with:  docker exec sendspin-shareplay aplay -l
#   Raspberry Pi 3.5 mm jack : hw:Headphones,0
#   HiFiBerry-style HAT DAC  : hw:sndrpihifiberry,0
#   USB DAC                  : hw:1,0
ALSA_PCM=hw:Headphones,0

# dmix      -- both players can hold the card at once (recommended)
# exclusive -- bit-perfect, but only one player at a time
# none      -- do not generate /etc/asound.conf at all
AUDIO_SHARING=dmix

# Mix rate used by dmix. 44100 matches AirPlay and avoids resampling it.
ALSA_RATE=44100

# ALSA device each player opens. Leave as "default" to use the shared device
# the entrypoint generates.
#SHAIRPORT_OUTPUT_DEVICE=default
#SENDSPIN_AUDIO_DEVICE=default

# Hardware volume control. Only works with AUDIO_SHARING=exclusive, since dmix
# has no mixer of its own. Check names with: docker exec ... amixer scontrols
#ALSA_MIXER_CONTROL=PCM
#ALSA_MIXER_DEVICE=hw:Headphones
#SENDSPIN_HARDWARE_VOLUME=false

##############################################################################
# Which services to run
##############################################################################
#ENABLE_AIRPLAY=1
#ENABLE_SENDSPIN=1
#ENABLE_WEB=1

# airplay2 (default), classic (AirPlay 1, lighter), or auto
#AIRPLAY_MODE=airplay2

##############################################################################
# Sendspin
##############################################################################
# Leave unset to discover servers over mDNS. Set to pin one server.
#SENDSPIN_URL=ws://192.168.1.10:8927/sendspin
#SENDSPIN_AUDIO_FORMAT=flac:48000:24:2
#SENDSPIN_INTERFACE=eth0

##############################################################################
# Bluetooth A2DP sink (optional, off by default)
##############################################################################
# Lets a phone connect directly and play over Bluetooth, as a third source
# alongside AirPlay and Sendspin.
#
# Turning this on needs two things beyond the variable below:
#
#   1. NET_ADMIN on the container -- uncomment it in the compose file.
#   2. The host's Bluetooth stack must be stopped. Only one bluetoothd can own
#      the adapter, and it has to be the container's:
#        sudo systemctl disable --now bluetooth
#      The Pi then has no Bluetooth of its own -- no BT keyboards, no host
#      pairing. If you need that, leave this off.
#
# Pairing is automatic and accepts anything in range. Paired devices are stored
# in config/bluetooth/ so they survive a rebuild.
#ENABLE_BLUETOOTH=1

# Name shown when pairing. Defaults to AIRPLAY_NAME.
#BLUETOOTH_NAME=Living Room

#BLUETOOTH_ADAPTER=hci0

# ALSA device Bluetooth audio is played to -- "default" is the shared dmix
# device, so Bluetooth mixes with the other two sources.
#BLUETOOTH_AUDIO_DEVICE=default

# Set to 0 once your devices are paired to stop advertising to strangers.
#BLUETOOTH_DISCOVERABLE=1

##############################################################################
# Spotify Connect (optional, off by default)
##############################################################################
# Makes the Pi appear in the Spotify app's device picker. Spotify removed
# username/password logins, so this works purely by Connect discovery: your
# phone must be on the same network, and you claim the speaker from the app.
# A Premium account is required, as it is for any Connect device.
#ENABLE_SPOTIFY=1

# Name shown in the Spotify device picker. Defaults to AIRPLAY_NAME.
#SPOTIFY_NAME=Living Room

#SPOTIFY_AUDIO_DEVICE=default
#SPOTIFY_INITIAL_VOLUME=60
#EXTRA_SPOTIFYD_ARGS=--volume-normalisation

##############################################################################
# DLNA / UPnP renderer (optional, off by default)
##############################################################################
# A "play to" target for Android apps, BubbleUPnP, foobar2000, Plex and most
# NAS media servers. This is the most useful option for Android, since AirPlay
# covers iOS and Spotify Connect only covers Spotify.
#ENABLE_DLNA=1

# Name shown in controllers. Defaults to AIRPLAY_NAME.
#DLNA_NAME=Living Room

#DLNA_PORT=49494
#DLNA_AUDIO_DEVICE=default

# Set 0 to also advertise video support. Leave at 1 for a speaker, or
# controllers will offer it as a display target.
#DLNA_AUDIO_ONLY=1

##############################################################################
# Home Assistant / MQTT (optional, off by default)
##############################################################################
# Publishes what is playing to MQTT and registers the speaker with Home
# Assistant via auto-discovery -- sensors for the track, a volume control,
# transport and restart buttons, and CPU/memory/temperature diagnostics.
#ENABLE_MQTT=1
#MQTT_HOST=192.168.1.10
#MQTT_PORT=1883
#MQTT_USERNAME=homeassistant
#MQTT_PASSWORD=secret
#MQTT_TLS=0

# Defaults to AIRPLAY_NAME. The device id and topic are slugified from it, so
# "Living Room" gives living_room and sendspin-shareplay/living_room.
#MQTT_DEVICE_NAME=Living Room
#MQTT_DEVICE_ID=living_room
#MQTT_BASE_TOPIC=sendspin-shareplay/living_room

# Must match Home Assistant's discovery prefix (its default is homeassistant).
#MQTT_DISCOVERY_PREFIX=homeassistant

# Where Home Assistant fetches cover art. Defaults to this machine's LAN
# address on WEB_PORT, which is right unless the container is behind a proxy.
#MQTT_ART_BASE_URL=http://192.168.1.20:8080

#MQTT_DIAGNOSTICS_INTERVAL=30

##############################################################################
# mDNS
##############################################################################
# auto (default) uses the host's avahi-daemon when it actually answers on the
# system bus -- the compose files mount /var/run/dbus and /var/run/avahi-daemon
# for that, because running a second daemon alongside the host's makes the two
# fight over the machine's .local name. If the sockets are there but Avahi does
# not answer, a local daemon runs under a distinct name instead. Force with
# "host" or "container".
#AVAHI_MODE=auto

# Interfaces Avahi may announce on. Defaults to every real interface -- so
# typically eth0,wlan0 -- excluding loopback and everything Docker creates,
# which keeps 172.x bridge addresses off the LAN. Narrow it if you want mDNS on
# only one link.
#AVAHI_INTERFACES=wlan0

# Override the .local name, container mode only. This is the machine's mDNS
# host name rather than the speaker's name, so it defaults to the hostname and
# NOT to AIRPLAY_NAME -- when another mDNS stack is publishing the address
# records, this has to match the name that stack already owns.
#AVAHI_HOST_NAME=living-room

# auto (default) publishes address records unless another mDNS responder is
# already running -- two responders collide on the shared IP and Avahi renames
# itself forever. Set "no" to always publish services only, "yes" to force.
#AVAHI_PUBLISH_ADDRESSES=auto

##############################################################################
# Web UI and logging
##############################################################################
WEB_PORT=8080
TZ=America/Los_Angeles

# info (default) or debug
#LOG_LEVEL=info

##############################################################################
# Escape hatches -- appended verbatim to each player's command line
##############################################################################
#EXTRA_SHAIRPORT_ARGS=--statistics
#EXTRA_SENDSPIN_ARGS=--static-delay-ms 50
